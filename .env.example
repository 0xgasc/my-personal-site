# ─── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — server-only. NEVER prefix with NEXT_PUBLIC_.
# Used to bypass RLS for admin writes via /api/admin/*.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Comma-separated email allow-list for admin access.
# Defaults to gasolomonc@gmail.com if unset.
ADMIN_EMAILS=gasolomonc@gmail.com

# ─── Stash (Aeter) ───────────────────────────────────────────
# Public Arweave/Irys upload backend. Default points at production.
NEXT_PUBLIC_STASH_SERVER=https://stash-production-47fc.up.railway.app
